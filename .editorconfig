root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,slnx,config}]
indent_style = tab
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2

[*.cs]
# Code is never wrapped to fit a column. There is no C# formatter setting
# that wraps or unwraps, so this is advisory only - it just stops editors
# drawing a guide and suggesting otherwise. Comments are still wrapped at 80
# by hand.
max_line_length = off

# Braces on their own line.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# A conditional never shares a line with its action, and a block is never
# collapsed onto one line. These two are the rules worth enforcing, because
# they are the ones an editor would otherwise quietly undo.
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false

# Braces around a lone statement are optional here; do not nag either way.
csharp_prefer_braces = false:silent

# var throughout.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Constants are SCREAMING_SNAKE_CASE.
dotnet_naming_rule.constants_upper_snake.severity = suggestion
dotnet_naming_rule.constants_upper_snake.symbols  = constant_fields
dotnet_naming_rule.constants_upper_snake.style    = upper_snake
dotnet_naming_symbols.constant_fields.applicable_kinds   = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.upper_snake.capitalization  = all_upper
dotnet_naming_style.upper_snake.word_separator  = _
